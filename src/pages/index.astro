---
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://happy-wakey.github.io");
const today = new Intl.DateTimeFormat("en", { weekday: "long", month: "long", day: "numeric" }).format(new Date("2026-09-05T12:00:00Z"));
const signals = [
  { icon: "↗", label: "Useful message", title: "Customer approval blocks launch", detail: "LinkedIn · VIP · reply requested by 09:30", tone: "hot", action: "Open thread" },
  { icon: "✦", label: "This day in history", title: "A three-minute piece of context", detail: "One dated summary, with source provenance", tone: "warm", action: "Read 48 sec" },
  { icon: "✈", label: "Travel", title: "ORD → SFO · on time", detail: "Gate C24 · leave by 12:10 · destination 17°C", tone: "cool", action: "Flight details" },
  { icon: "≈", label: "Extended outlook", title: "Rain risk late next week", detail: "Days 15–21 are an ensemble outlook, not a promise", tone: "cool", action: "Why uncertain?" },
];
const briefingLanes = [
  ["Messages without feeds", "VIPs, direct asks, bottlenecks and escalations—never a generic timeline route."],
  ["Travel that follows you", "Flights, destination weather, local time and leave-by signals in one card."],
  ["Work, minus the dashboards", "Chosen KPIs, CRM risk and engineering blockers summarized for your role."],
  ["A little useful context", "Calendar, markets, tasks, news and one cited this-day-in-history note."],
  ["Three-minute audio", "The same authorized briefing, spoken while you get ready. No hidden extra feed."],
  ["A screen with an ending", "A hard card cap and a visible noise count keep the morning briefing finite."],
];
const connectorLabels = ["Email", "Calendar", "WhatsApp", "LinkedIn", "X DMs", "Slack", "Teams", "Flights", "Weather", "Markets", "CRM"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Happy Wakey is a feedless morning heads-up display for useful messages, calendar, travel, weather, work signals, markets, history, tasks, and optional audio." />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Happy Wakey · Open the day, not the feed" />
    <meta property="og:description" content="A finite, AI-curated morning briefing with useful-message deep links and no timeline." />
    <meta property="og:url" content={canonical} />
    <title>Happy Wakey · Open the day, not the feed</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav-shell">
      <a class="brand" href="/" aria-label="Happy Wakey home"><span class="brand-mark">HW</span><span>Happy Wakey</span></a>
      <nav aria-label="Primary navigation">
        <a href="#briefing">Briefing</a>
        <a href="#signals">Signals</a>
        <a href="#access">Access</a>
        <a href="#trust">Trust</a>
        <a href="https://github.com/happy-wakey">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="nav-actions">
        <a href="https://user.hawky.pro/login">Log in</a>
        <a class="button button-small" href="#access">Get started</a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="briefing">
        <div class="hero-copy">
          <p class="kicker"><span></span> A morning heads-up display</p>
          <h1>Open the day.<br /><em>Not the feed.</em></h1>
          <p class="lede">Happy Wakey finds the few messages, meetings, travel changes, work signals, and bits of context that matter—then gives your morning screen an ending.</p>
          <div class="hero-actions">
            <a class="button" href="https://user.hawky.pro/login">Start for myself <span aria-hidden="true">→</span></a>
            <a class="button button-quiet" href="https://org.hawky.pro/login">Set up my organization <span aria-hidden="true">→</span></a>
          </div>
          <p class="microcopy">Shared Auth · explicit connector consent · no infinite scroll</p>
        </div>

        <div class="hud-wrap" aria-label="Illustrative Happy Wakey morning briefing">
          <div class="hud">
            <header class="hud-head">
              <div><span class="sun">●</span><strong>Good morning, Alex.</strong><small>{today}</small></div>
              <div class="hud-status"><span></span> Briefing live</div>
            </header>
            <div class="hud-grid">
              <section class="card-stack" aria-label="Morning briefing cards">
                {signals.map((signal, index) => (
                  <article class:list={["signal", `signal-${signal.tone}`]}>
                    <div class="signal-icon" aria-hidden="true">{signal.icon}</div>
                    <div class="signal-copy">
                      <p>{signal.label}</p>
                      <h2>{signal.title}</h2>
                      <span>{signal.detail}</span>
                    </div>
                    <a href={index === 0 ? "#useful-messages" : "#signals"} aria-label={`${signal.action}: ${signal.title}`}>{signal.action} <span aria-hidden="true">→</span></a>
                  </article>
                ))}
              </section>
              <aside class="hud-side">
                <section class="focus-card">
                  <p>Before 10:00</p>
                  <strong>2 decisions</strong>
                  <span>1 meeting · 1 customer reply</span>
                  <div class="progress"><i></i></div>
                </section>
                <section class="audio-card">
                  <div class="play" aria-hidden="true">▶</div>
                  <div><p>Audio briefing</p><strong>03:04</strong></div>
                  <span class="wave" aria-hidden="true">▂▄▆▃▇▅▂▄</span>
                </section>
                <section class="noise-card"><strong>47</strong><span>low-signal items kept out of your morning</span></section>
              </aside>
            </div>
            <footer class="hud-foot"><span>Next refresh 07:30</span><span>WebSocket · sequence 284</span><span>8-card limit</span></footer>
          </div>
          <p class="preview-note">Product preview · synthetic data</p>
        </div>
      </section>

      <section class="manifesto" id="useful-messages">
        <p class="section-label">THE DIFFERENCE</p>
        <div>
          <h2>The message can be useful.<br />The surrounding feed is not.</h2>
          <p>Happy Wakey’s AI can flag a VIP, a direct ask, a team bottleneck, a travel disruption, or a customer escalation. Only a qualifying decision can unlock an expiring deep link to that specific message. There is no “open social” escape hatch.</p>
        </div>
        <aside>
          <span>Useful decision</span>
          <strong>0.94</strong>
          <ul><li>VIP sender</li><li>Reply requested</li><li>Blocking others</li></ul>
          <p>Link expires at 09:45 · reauthentication required</p>
        </aside>
      </section>

      <section class="lanes" id="signals">
        <header><p class="section-label">YOUR MORNING, COMPOSED</p><h2>Signal from every lane.<br /><em>Noise from none.</em></h2></header>
        <div class="lane-grid">
          {briefingLanes.map(([title, copy], index) => (
            <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{copy}</p></article>
          ))}
        </div>
        <div class="connectors" aria-label="Planned connector categories">
          <span>Consent one source at a time</span>
          <div>{connectorLabels.map((label) => <em>{label}</em>)}</div>
          <p>Availability depends on provider-supported APIs, scopes, plan, and region. Happy Wakey does not automate consumer sessions or scrape private feeds.</p>
        </div>
      </section>

      <section class="access" id="access">
        <header><p class="section-label">TWO WAYS IN</p><h2>Personal by default.<br />Organization-ready.</h2></header>
        <div class="access-grid">
          <article>
            <span class="access-type">FOR ME · B2C</span>
            <h3>A private morning command center.</h3>
            <p>Choose your time zone, morning window, briefing lanes, and each connector. Individual accounts—including one-time use—receive their own isolated tenant.</p>
            <ul><li>Per-source consent and revoke</li><li>Rust and Flutter desktop choices</li><li>Mobile, audio, notifications, and Bluetooth</li></ul>
            <a class="button" href="https://user.hawky.pro/login">Individual login <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <span class="access-type">FOR TEAMS · B2B</span>
            <h3>A useful start for every employee.</h3>
            <p>Owners manage seats, roles, source policy, retention, and residency. They see operational health and aggregate adoption—not employee private-message contents.</p>
            <ul><li>Managed membership through Shared Auth</li><li>Role-specific KPIs and source policy</li><li>Separate canonical, auth, and admin planes</li></ul>
            <a class="button button-dark" href="https://org.hawky.pro/login">Organization login <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </section>

      <section class="trust" id="trust">
        <div><p class="section-label">BUILT TO SAY “NO”</p><h2>Private messages require private architecture.</h2></div>
        <div class="trust-list">
          <article><span>01</span><h3>Identity is server-derived</h3><p>Shared Auth supplies subject, tenant, audience, and session. The browser cannot choose its own authority.</p></article>
          <article><span>02</span><h3>Search stays tenant-scoped</h3><p>Database policy, vector metadata filters, source ACLs, hashes, and retention work together.</p></article>
          <article><span>03</span><h3>Realtime can resume safely</h3><p>WebSocket, TLS/TCP, and NATS share sequenced contracts without persisting bearer credentials.</p></article>
          <article><span>04</span><h3>Discovery is not causation</h3><p>Regression findings carry sample size, confidence, p-values, corrections, and an explicit no-causal-claim rule.</p></article>
        </div>
      </section>

      <section class="closing">
        <p class="section-label">TOMORROW MORNING</p>
        <h2>Know what matters.<br /><em>Then go live the day.</em></h2>
        <div><a class="button" href="https://user.hawky.pro/login">Start for myself <span aria-hidden="true">→</span></a><a href="https://github.com/happy-wakey">Explore the open repositories <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>

    <footer class="site-foot"><a class="brand" href="/"><span class="brand-mark">HW</span><span>Happy Wakey</span></a><p>A bounded morning briefing. Built with Astro, Rust, Dart, and restraint.</p><span>{new Date().getFullYear()}</span></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #f4f0e6; }
  :global(body) { overflow-x: hidden; margin: 0; color: #17241f; background: #f4f0e6; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; }
  :global(::selection) { color: #fff; background: #e95d2a; }
  :global(:focus-visible) { outline: 3px solid #e95d2a; outline-offset: 4px; }
  .skip { position: fixed; z-index: 200; top: .75rem; left: .75rem; padding: .75rem 1rem; color: white; background: #17241f; transform: translateY(-160%); }
  .skip:focus { transform: none; }
  .nav-shell { position: sticky; z-index: 100; top: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4.75rem; padding: 0 3.5vw; border-bottom: 1px solid #cfc8b8; background: color-mix(in srgb, #f4f0e6 92%, transparent); backdrop-filter: blur(18px); }
  .brand { display: inline-flex; align-items: center; gap: .75rem; width: max-content; color: #17241f; font-weight: 780; letter-spacing: -.035em; text-decoration: none; }
  .brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; color: #f4f0e6; background: #e95d2a; border-radius: 50%; font: 700 .65rem/1 ui-monospace, monospace; letter-spacing: -.03em; }
  nav { display: flex; gap: clamp(1rem, 2.5vw, 2.4rem); color: #5c675f; font: 650 .68rem/1 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
  nav a, .nav-actions > a:first-child { text-decoration: none; }
  nav a:hover, .nav-actions > a:first-child:hover { color: #e95d2a; }
  .nav-actions { display: flex; justify-self: end; align-items: center; gap: 1.2rem; font-size: .78rem; font-weight: 700; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.8rem; min-width: 12rem; padding: .95rem 1.1rem; color: white; background: #e95d2a; border: 1px solid #e95d2a; border-radius: .25rem; font: 750 .76rem/1 ui-monospace, monospace; letter-spacing: .025em; text-decoration: none; }
  .button:hover { color: #f4f0e6; background: #17241f; border-color: #17241f; }
  .button-small { min-width: auto; padding: .72rem .9rem; }
  .button-quiet { color: #17241f; background: transparent; border-color: #bcb4a2; }
  .button-dark { background: #17241f; border-color: #17241f; }
  .hero { display: grid; grid-template-columns: minmax(22rem, .78fr) minmax(38rem, 1.22fr); min-width: 0; min-height: calc(100vh - 4.75rem); border-bottom: 1px solid #cfc8b8; }
  .hero-copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: 7vw 4vw 7vw 6vw; border-right: 1px solid #cfc8b8; }
  .kicker, .section-label { margin: 0 0 1.7rem; color: #677068; font: 700 .68rem/1.4 ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
  .kicker span { display: inline-block; width: .5rem; height: .5rem; margin-right: .55rem; background: #e95d2a; border-radius: 50%; }
  h1 { margin: 0; font: 500 clamp(3.6rem, 6.4vw, 7.4rem)/.86 Georgia, "Times New Roman", serif; letter-spacing: -.065em; }
  h1 em, h2 em { color: #e95d2a; font-weight: inherit; }
  .lede { max-width: 38rem; margin: 2.1rem 0 0; color: #5c675f; font-size: clamp(1rem, 1.3vw, 1.18rem); line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.3rem; }
  .microcopy { margin: 1.2rem 0 0; color: #7e877f; font: .68rem/1.5 ui-monospace, monospace; }
  .hud-wrap { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: clamp(2rem, 5vw, 5rem); background: #d9e4dc; }
  .hud { overflow: hidden; width: 100%; min-width: 0; max-width: 58rem; margin: auto; border: 1px solid #99a79d; border-radius: .65rem; background: #f9f7f0; box-shadow: 0 2.5rem 6rem rgba(38, 65, 52, .17); }
  .hud-head { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.4rem; border-bottom: 1px solid #d6d8d0; }
  .hud-head > div:first-child { display: grid; grid-template-columns: auto 1fr; column-gap: .75rem; align-items: center; }
  .hud-head strong { font-size: .98rem; }
  .hud-head small { grid-column: 2; margin-top: .2rem; color: #788078; font-size: .72rem; }
  .sun { grid-row: 1 / 3; color: #e95d2a; font-size: 1.6rem; }
  .hud-status { display: flex; align-items: center; gap: .45rem; color: #627067; font: 650 .62rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .hud-status span { width: .5rem; height: .5rem; background: #47a472; border-radius: 50%; box-shadow: 0 0 0 .25rem #dceee4; }
  .hud-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(12rem, .7fr); }
  .card-stack { padding: 1rem; border-right: 1px solid #d6d8d0; }
  .signal { display: grid; grid-template-columns: 2.3rem minmax(0, 1fr) auto; gap: .85rem; align-items: center; padding: 1rem; border-bottom: 1px solid #dedfd9; }
  .signal:last-child { border-bottom: 0; }
  .signal-icon { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border-radius: .4rem; font-size: 1rem; }
  .signal-hot .signal-icon { color: #a23d1c; background: #f8d9ca; }
  .signal-warm .signal-icon { color: #8b6824; background: #f1e3bd; }
  .signal-cool .signal-icon { color: #316c5e; background: #d9ebe3; }
  .signal-copy { min-width: 0; }
  .signal-copy p, .focus-card p, .audio-card p { margin: 0 0 .3rem; color: #7a827b; font: 650 .58rem/1 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .signal-copy h2 { overflow: hidden; margin: 0; font-size: .85rem; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
  .signal-copy span { display: block; overflow: hidden; margin-top: .3rem; color: #737b74; font-size: .66rem; text-overflow: ellipsis; white-space: nowrap; }
  .signal > a { color: #e95d2a; font: 680 .62rem/1 ui-monospace, monospace; text-underline-offset: .25rem; white-space: nowrap; }
  .hud-side { display: flex; flex-direction: column; padding: 1rem; gap: .75rem; }
  .hud-side section { padding: 1rem; border: 1px solid #d6d8d0; border-radius: .4rem; }
  .focus-card strong { display: block; font: 500 1.45rem/1.2 Georgia, serif; }
  .focus-card > span { display: block; margin-top: .35rem; color: #737b74; font-size: .65rem; }
  .progress { overflow: hidden; height: .25rem; margin-top: 1rem; background: #e2e2dc; border-radius: 1rem; }
  .progress i { display: block; width: 62%; height: 100%; background: #e95d2a; }
  .audio-card { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: center; background: #17241f; color: white; }
  .play { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; color: #17241f; background: #f4f0e6; border-radius: 50%; font-size: .7rem; }
  .audio-card p { color: #aeb8b1; }
  .audio-card strong { font: 500 1.15rem/1 Georgia, serif; }
  .wave { grid-column: 1 / 3; color: #e95d2a; letter-spacing: .2em; }
  .noise-card { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: center; margin-top: auto; }
  .noise-card strong { color: #e95d2a; font: 500 2rem/1 Georgia, serif; }
  .noise-card span { color: #6c756e; font-size: .65rem; line-height: 1.35; }
  .hud-foot { display: flex; justify-content: space-between; padding: .7rem 1.4rem; color: #7a827b; border-top: 1px solid #d6d8d0; font: .55rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .preview-note { margin: .75rem auto 0; color: #637268; font: .58rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .manifesto { display: grid; grid-template-columns: .4fr 1.2fr .55fr; gap: 4vw; padding: clamp(5rem, 10vw, 10rem) 6vw; background: #17241f; color: #f4f0e6; }
  .manifesto .section-label { color: #e95d2a; }
  .manifesto h2, .lanes header h2, .access header h2, .trust h2, .closing h2 { margin: 0; font: 450 clamp(2.4rem, 4.2vw, 5rem)/.98 Georgia, serif; letter-spacing: -.05em; }
  .manifesto > div p { max-width: 44rem; margin: 2rem 0 0; color: #acb7b0; line-height: 1.75; }
  .manifesto aside { align-self: start; padding: 1.5rem; color: #17241f; background: #f4f0e6; border-radius: .35rem; }
  .manifesto aside > span { font: 650 .6rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .manifesto aside strong { display: block; margin: .4rem 0 1rem; color: #e95d2a; font: 500 3rem/1 Georgia, serif; }
  .manifesto ul { padding-left: 1.1rem; font-size: .72rem; line-height: 1.8; }
  .manifesto aside p { color: #6f786f; font: .58rem/1.5 ui-monospace, monospace; }
  .lanes, .access, .trust { padding: clamp(5rem, 9vw, 9rem) 6vw; border-bottom: 1px solid #cfc8b8; }
  .lanes header, .access header { display: grid; grid-template-columns: .55fr 1.45fr; margin-bottom: 4rem; }
  .lane-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #cfc8b8; border-left: 1px solid #cfc8b8; }
  .lane-grid article { min-height: 16rem; padding: 1.8rem; border-right: 1px solid #cfc8b8; border-bottom: 1px solid #cfc8b8; }
  .lane-grid article > span, .trust-list article > span { color: #e95d2a; font: .65rem/1 ui-monospace, monospace; }
  h3 { margin: 2.2rem 0 .8rem; font-size: 1rem; letter-spacing: -.02em; }
  .lane-grid p, .trust-list p { margin: 0; color: #69736c; font-size: .84rem; line-height: 1.65; }
  .connectors { display: grid; grid-template-columns: .4fr 1.2fr .55fr; gap: 3vw; align-items: start; margin-top: 3rem; }
  .connectors > span { color: #657168; font: 650 .65rem/1.5 ui-monospace, monospace; text-transform: uppercase; }
  .connectors > div { display: flex; flex-wrap: wrap; gap: .5rem; }
  .connectors em { padding: .55rem .7rem; color: #345c4f; background: #dce8df; border-radius: 3rem; font: 650 .66rem/1 ui-monospace, monospace; font-style: normal; }
  .connectors p { margin: 0; color: #758078; font-size: .7rem; line-height: 1.6; }
  .access { background: #e95d2a; color: #fff9ed; }
  .access .section-label { color: #4d2417; }
  .access-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid rgba(255,255,255,.45); }
  .access-grid article { padding: clamp(2rem, 4vw, 4rem); }
  .access-grid article:first-child { border-right: 1px solid rgba(255,255,255,.45); }
  .access-type { font: 700 .65rem/1 ui-monospace, monospace; letter-spacing: .08em; }
  .access-grid h3 { max-width: 20ch; margin: 3rem 0 1rem; font: 450 clamp(2rem, 3vw, 3.3rem)/1 Georgia, serif; letter-spacing: -.045em; }
  .access-grid p { max-width: 38rem; line-height: 1.7; }
  .access-grid ul { margin: 2rem 0; padding-left: 1.2rem; line-height: 1.9; }
  .access .button { color: #17241f; background: #fff9ed; border-color: #fff9ed; }
  .access .button-dark { color: #fff; background: #17241f; border-color: #17241f; }
  .trust { display: grid; grid-template-columns: .65fr 1.35fr; gap: 5vw; background: #d9e4dc; }
  .trust-list { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #aebbb2; border-left: 1px solid #aebbb2; }
  .trust-list article { padding: 2rem; border-right: 1px solid #aebbb2; border-bottom: 1px solid #aebbb2; }
  .closing { padding: clamp(6rem, 13vw, 13rem) 6vw 5rem; }
  .closing h2 { max-width: 18ch; font-size: clamp(3.5rem, 7vw, 8rem); line-height: .88; }
  .closing > div { display: flex; align-items: center; gap: 2rem; margin-top: 3.5rem; }
  .closing > div > a:last-child { color: #66716a; font: .7rem/1.4 ui-monospace, monospace; text-underline-offset: .3rem; }
  .site-foot { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; padding: 1.4rem 3.5vw; color: #69736c; border-top: 1px solid #cfc8b8; font-size: .65rem; }
  .site-foot p { margin: 0; }
  .site-foot > span { justify-self: end; font-family: ui-monospace, monospace; }
  @media (max-width: 1050px) {
    .nav-shell { grid-template-columns: 1fr auto; }
    .nav-shell nav { display: none; }
    .hero { grid-template-columns: 1fr; }
    .hero-copy { min-height: 40rem; border-right: 0; border-bottom: 1px solid #cfc8b8; }
    .manifesto { grid-template-columns: .35fr 1fr; }
    .manifesto aside { grid-column: 2; }
    .connectors { grid-template-columns: .45fr 1fr; }
    .connectors p { grid-column: 2; }
